{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:path:allow-app-data-recursive",
    "core:path:allow-all",
    {
      "identifier": "core:protocol-asset",
      "allow": [
        {
          "path": "$APP_DATA/thumbnails/**"
        },
        {
          "path": "**"
        }
      ]
    }
  ]
}
