{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/popover": [
        "./src/app/libs/ui/popover/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./src/app/libs/ui/utils/src/index.ts"
      ],
      "@spartan-ng/helm/command": [
        "./src/app/libs/ui/command/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./src/app/libs/ui/button/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./src/app/libs/ui/icon/src/index.ts"
      ],
      "@spartan-ng/helm/card": [
        "./src/app/libs/ui/card/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
